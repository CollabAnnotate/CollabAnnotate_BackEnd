# Copier ce fichier en .env et adapter les valeurs.

# Django
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=a-remplacer
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (utilisé par docker-compose.yml)
POSTGRES_DB=yolo_annotation
POSTGRES_USER=yolo_admin
POSTGRES_PASSWORD=a-remplacer

# Connexion Django : doit reprendre les valeurs POSTGRES_* ci-dessus
DATABASE_URL=postgres://yolo_admin:a-remplacer@localhost:5432/yolo_annotation
